<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:SorterGUI.Windows"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="SorterGUI.Windows.Synchronize"
        Title="Synchronize"
        Width="500"
        Height="350"
        MinWidth="500"
        MinHeight="350"
        x:DataType="windows:Synchronize"
        Icon="/Assets/icon.ico">
        
        <Grid Background="{CompiledBinding SecondaryColor}" RowDefinitions="Auto,*,Auto,Auto">
                <!-- Changes Labels -->
                <Grid Grid.Row="0" Background="{CompiledBinding PrimaryColor}" Margin="5, 5, 5, 0" ColumnDefinitions="*,*" ColumnSpacing="5">
                        <Label Grid.Column="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="OrangeRed" Content="{CompiledBinding RemoveText}"></Label>
                        <Label Grid.Column="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="SpringGreen" Content="{CompiledBinding AddText}"></Label>
                </Grid>
                
                <!-- Changes Lists -->
                <Grid Grid.Row="1" Margin="5" ColumnDefinitions="*,*" ColumnSpacing="5">
                        <ListBox Grid.Column="0" Name="RemoveList" Background="{CompiledBinding PrimaryColor}" ItemsSource="{CompiledBinding RemoveItems}">
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                                <TextBlock TextAlignment="Left" FontSize="12" LineHeight="16" TextWrapping="Wrap" Text="{CompiledBinding RelativePath}"></TextBlock>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox Grid.Column="1" Name="AddList" Background="{CompiledBinding PrimaryColor}" ItemsSource="{CompiledBinding AddItems}">
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                                <TextBlock TextAlignment="Left" FontSize="12" LineHeight="16" TextWrapping="Wrap" Text="{CompiledBinding RelativePath}"></TextBlock>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                </Grid>
                
                <!-- Warning Bar -->
                <Label Grid.Row="2" Background="{CompiledBinding PrimaryColor}" Margin="5, 0, 5, 5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="Yellow" Content="{CompiledBinding WarningText}"></Label>
                
                <!-- Bottom Bar -->
                <Grid Grid.Row="3" Background="{CompiledBinding PrimaryColor}" Margin="5,0,5,5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                        <Button Grid.Column="0" Name="Cancel" IsEnabled="{CompiledBinding Synchronized}" Background="{CompiledBinding SecondaryColor}" Margin="4, 4, 4, 4" Width="100" Height="35" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16" Click="OnCancelClicked" Content="{CompiledBinding CancelText}"></Button>
                        <Label Grid.Column="1" IsVisible="{CompiledBinding Scanning}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{CompiledBinding ScanningText}"></Label>
                        <Button Grid.Column="2" Name="SynchronizeCtrl" IsEnabled="{CompiledBinding CanSynchronize}" Background="{CompiledBinding SecondaryColor}" Margin="4, 4, 4, 4" Width="125" Height="35" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16" Click="OnSynchronizeClicked" Content="{CompiledBinding SynchronizeText}"></Button>
                </Grid>
        </Grid>
</Window>
