<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:SorterGUI.Windows"
        mc:Ignorable="d" d:DesignWidth="275" d:DesignHeight="100"
        x:Class="SorterGUI.Windows.Processing"
        Title="Processing"
        Width="275"
        Height="100"
        MinWidth="275"
        MinHeight="100"
        CanResize="False"
        x:DataType="windows:Processing"
        Icon="/Assets/icon.ico">
        
        <Panel Background="{CompiledBinding SecondaryColor}">
                <DockPanel Background="{CompiledBinding PrimaryColor}" Margin="5" LastChildFill="False">
                        <Label DockPanel.Dock="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="50" Margin="0, 5, 0, 0" FontSize="18" Content="{CompiledBinding ProcessingText}"></Label>
                        <ProgressBar DockPanel.Dock="Bottom" Name="ProgressBar" Foreground="{CompiledBinding SecondaryColor}" Width="210" Height="24" Margin="0, 0, 0, 10" ShowProgressText="True" Value="{CompiledBinding Progress}"></ProgressBar>
                </DockPanel>
        </Panel>
</Window>
